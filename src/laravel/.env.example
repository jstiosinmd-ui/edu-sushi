APP_NAME=SUSHI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Set TRUSTED_PROXIES=* only behind the hosting provider's reverse proxy.
TRUSTED_PROXIES=
# Enable secure cookies when APP_URL uses HTTPS.
SESSION_SECURE_COOKIE=false
APP_LOCALE=en
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sushi
DB_USERNAME=sushi
DB_PASSWORD=
DB_SSLMODE=prefer
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=360
CACHE_STORE=database
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12
MAIL_MAILER=log
SUSHI_VAPID_PUBLIC_KEY=
SUSHI_VAPID_PRIVATE_KEY=
SUSHI_VAPID_SUBJECT=
